#pragma once

#define SCENARIOS_LIMIT 100

// MQTT: intervalo entre registro/reconexão
#define MQTT_RECONNECT_INTERVAL_MS 30000

// Wi-Fi: intervalo entre tentativas de reconexão automática
#define WIFI_RECONNECT_INTERVAL_MS 30000

// Backend API (Echoes-Server)
// HTTPS obrigatório em produção. 1 = permite http:// (somente laboratório isolado) (S3)
#define API_ALLOW_PLAIN_HTTP 1
// API_BASE_URL em .env/ambiente pode substituir este padrão.
#ifndef API_BASE_URL
#define API_BASE_URL "http://192.168.1.50:8080"
#endif

// FSR
#define FSR_1 32
#define FSR_2 33

// MAX98357A - SD_MODE
#define AMP_1 13
#define AMP_2 14

// I2S compartilhado
#define I2S_BCLK 26
#define I2S_LRC 25
#define I2S_DOUT 22

// Parâmetros FSRs
